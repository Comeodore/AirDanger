require "open3"

%w[LANG LC_ALL].each do |var|
  ENV[var] = "en_US.UTF-8" unless ENV[var].to_s.match?(/UTF-8/i)
end
Encoding.default_external = Encoding::UTF_8

default_platform(:ios)

REPO_ROOT = File.expand_path("..", __dir__)
PROJECT = File.join(REPO_ROOT, "Air Danger.xcodeproj")
SCHEME = "Air Danger"
APP_IDENTIFIER = "comeodore.airdanger"
TEAM_ID = "VBV72WF24P"
ARCHIVE_DIR = File.join(REPO_ROOT, "build", "appstore")

platform :ios do
  desc "Archive a signed Release build and upload it to TestFlight (internal + external). Options: build, version, changelog"
  lane :beta do |options|
    key = asc_api_key
    settings = []
    settings << "CURRENT_PROJECT_VERSION=#{options[:build]}" if options[:build]
    settings << "MARKETING_VERSION=#{options[:version]}" if options[:version]
    ipa = build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      output_directory: ARCHIVE_DIR,
      derived_data_path: File.join(REPO_ROOT, "build", "appstore-dd"),
      buildlog_path: File.join(REPO_ROOT, "build", "logs"),
      clean: true,
      include_symbols: true,
      xcargs: (provisioning_xcargs + settings).join(" "),
      export_options: {
        teamID: TEAM_ID,
        signingStyle: "automatic",
        uploadSymbols: true
      }
    )
    upload_to_testflight(
      api_key: key,
      ipa: ipa,
      app_identifier: APP_IDENTIFIER,
      changelog: options[:changelog] || default_changelog,
      notify_external_testers: true
    )
    send_to_external_groups(get_ipa_info_plist_value(ipa: ipa, key: "CFBundleVersion"))
    UI.success("Uploaded #{ipa} to TestFlight (internal + external)")
  end

  desc "Send an already uploaded build to the external TestFlight groups. Options: build"
  lane :external do |options|
    UI.user_error!("Pass the build number: fastlane external build:25 --env appstore") unless options[:build]
    asc_api_key
    send_to_external_groups(options[:build].to_s)
  end
end

def send_to_external_groups(build_number)
  app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
  build = Spaceship::ConnectAPI::Build.all(app_id: app.id, build_number: build_number, processing_states: "VALID", limit: 1).first
  UI.user_error!("Build #{build_number} is not processed in App Store Connect") if build.nil?
  groups = app.get_beta_groups(filter: { isInternalGroup: false })
  UI.user_error!("No external TestFlight group for #{APP_IDENTIFIER}") if groups.empty?
  build.post_beta_app_review_submission if build.ready_for_beta_submission?
  build.add_beta_groups(beta_groups: groups)
  UI.success("Build #{build_number} sent to external groups: #{groups.map(&:name).join(', ')}")
end

def asc_api_key
  key_id = ENV["ASC_KEY_ID"].to_s
  issuer_id = ENV["ASC_ISSUER_ID"].to_s
  if key_id.empty? && issuer_id.empty?
    UI.important("No ASC_KEY_ID / ASC_ISSUER_ID — falling back to interactive Apple ID sign-in (2FA prompts).")
    return nil
  end
  if key_id.empty? || issuer_id.empty?
    missing = key_id.empty? ? "ASC_KEY_ID" : "ASC_ISSUER_ID"
    UI.user_error!("#{missing} is missing from fastlane/.env.appstore — half-configured API key, refusing to fall back to Apple ID sign-in.")
  end

  path = ENV["ASC_KEY_PATH"].to_s
  path = File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{key_id}.p8") if path.empty?
  UI.user_error!("App Store Connect key not found at #{path}") unless File.exist?(path)

  app_store_connect_api_key(
    key_id: key_id,
    issuer_id: issuer_id,
    key_filepath: path,
    duration: 1200,
    in_house: false
  )
end

def provisioning_xcargs
  args = ["-allowProvisioningUpdates"]
  key_id = ENV["ASC_KEY_ID"].to_s
  issuer_id = ENV["ASC_ISSUER_ID"].to_s
  return args if key_id.empty? || issuer_id.empty?

  path = ENV["ASC_KEY_PATH"].to_s
  path = File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{key_id}.p8") if path.empty?
  args + [
    "-authenticationKeyPath", path,
    "-authenticationKeyID", key_id,
    "-authenticationKeyIssuerID", issuer_id
  ]
end

def default_changelog
  subject, = Open3.capture2("git", "-C", REPO_ROOT, "log", "-1", "--pretty=%s")
  subject.strip
end
